<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net472</TargetFramework>
    <AssemblyName>ZyMonoReceiver</AssemblyName>
    <Product>ZyMono Receiver</Product>
    <Company>TheHolyOneZ</Company>
    <Authors>TheHolyOneZ</Authors>
    <Description>In-game pipe-injection receiver for ZyMono — loads a managed assembly on the Unity main thread over a named pipe.</Description>
    <Copyright>Copyright © 2026 TheHolyOneZ — GPL-3.0-only</Copyright>
    <Version>0.2.0</Version>
    <LangVersion>latest</LangVersion>
    <Configuration Condition=" '$(Configuration)' == '' ">Release</Configuration>
    <!-- BepInEx plugins are plain class libraries; no runtime output needed. -->
    <AppendTargetFrameworkToOutputPath>false</AppendTargetFrameworkToOutputPath>
    <GenerateAssemblyInfo>true</GenerateAssemblyInfo>
    <NoWarn>$(NoWarn);CS0436</NoWarn>
  </PropertyGroup>

  <ItemGroup>
    <!-- BaseUnityPlugin + logging (BepInEx 5, Mono). -->
    <PackageReference Include="BepInEx.Core" Version="5.4.21" />
    <!-- UnityEngine reference assemblies (MonoBehaviour, GameObject, Object). -->
    <PackageReference Include="UnityEngine.Modules" Version="2021.3.0" IncludeAssets="compile" PrivateAssets="all" />
  </ItemGroup>

</Project>
