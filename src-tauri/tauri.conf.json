    "resources": {
      "../ZyMono.Receiver/bin/Release/ZyMonoReceiver.dll": "ZyMonoReceiver.dll"
    },
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/icon.ico",
      "icons/icon.png"
    ]
  }
