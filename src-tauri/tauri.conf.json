{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "ZyMono",
  "version": "0.3.1",
  "identifier": "eu.zlogic.zymono",
  "build": {
    "beforeDevCommand": "pnpm dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "pnpm build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "ZyMono",
        "width": 1121,
        "height": 721,
        "minWidth": 720,
        "minHeight": 520,
        "resizable": true,
        "theme": "Dark",
        "decorations": false,
        "transparent": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "plugins": {
    "updater": {
      "endpoints": ["https://zlogic.eu/zymono/latest.json"],
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IEQ0N0YzMUQ1NkI2OEIzRUMKUldUc3MyaHIxVEYvMUVvcXo1dkg2NzhlNjBBZEo4UEN2Slc5bVNJaUtZc2U4VVZlQm56bnpyNE8K"
    }
  },
  "bundle": {
    "active": true,
    "createUpdaterArtifacts": true,
    "targets": ["nsis", "msi"],
    "publisher": "TheHolyOneZ",
    "homepage": "https://zlogic.eu/zymono/",
    "category": "DeveloperTool",
    "shortDescription": "Windows-native Unity game injector (Mono & IL2CPP)",
    "longDescription": "ZyMono is a Windows-native Unity game injector for both Mono and IL2CPP titles. It loads C# or C++ mods into a running game and picks the right route automatically — direct in-memory Mono load, a pipe to an in-game receiver when BepInEx or MelonLoader is live, native LoadLibrary, in-memory manual map, or a proxy preloader — decided from the running process and the DLL you picked, not folders on disk. For legitimate game modding of titles you own.",
    "copyright": "Copyright © 2026 TheHolyOneZ — GPL-3.0-only",
    "licenseFile": "../LICENSE",
    "resources": {
      "../ZyMono.Receiver/bin/Release/ZyMonoReceiver.dll": "ZyMonoReceiver.dll",
      "../ZyMono.Receiver.IL2CPP/bin/Release/ZyMonoReceiverIL2CPP.dll": "ZyMonoReceiverIL2CPP.dll",
      "../ZyMono.MelonReceiver/bin/Release/ZyMonoMelonReceiver.dll": "ZyMonoMelonReceiver.dll"
    },
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/icon.ico",
      "icons/icon.png"
    ]
  }
}
