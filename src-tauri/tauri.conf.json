  "productName": "ZyMono",
  "version": "0.2.0",
  "identifier": "eu.zlogic.zymono",
  "build": {
    "beforeDevCommand": "pnpm dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "pnpm build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "ZyMono",
        "width": 1121,
        "height": 721,
        "minWidth": 720,
        "minHeight": 520,
        "resizable": true,
        "theme": "Dark",
        "decorations": false,
        "transparent": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "plugins": {
    "updater": {
      "endpoints": ["https://zlogic.eu/zymono/latest.json"],
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDYyN0E2QjJEREMyM0JBQQpSV1NxTzhMZHNxWW5Ca1YrbzN5SVBmQkVqMEtqSkJ0R1FLUGVqWEhkMEo5dk12WURWUk10QVlnbwo="
    }
  },
  "bundle": {
    "active": true,
    "createUpdaterArtifacts": true,
    "targets": ["nsis", "msi"],
    "publisher": "TheHolyOneZ",
    "homepage": "https://zlogic.eu/zymono/",
    "category": "DeveloperTool",
